<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zzkingcc</groupId>
        <artifactId>DomainPlane</artifactId>
        <version>v1.0-beta.1</version>
    </parent>

    <artifactId>domainplane-chat-client</artifactId>
    <name>domainplane-chat-client</name>
    <description>DomainPlane 对话 SDK：唯一入口 DomainPlaneAgent（forDomain → ask/stream/events/resume/stop）。
        只做对话 —— 知识库在 domainplane-kb-client、工具注册在 domainplane-tool-provider，由接入方按需引入。</description>

    <dependencies>
        <!-- ===== 客户端基础设施：WebClient 装配 + 凭证换取 + 错误翻译 + 启动期连通性探测 =====
             与知识库 SDK 共用同一份，同时引入两个 SDK 也只装配一次 -->
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-client-core</artifactId>
        </dependency>

        <!-- ===== Spring Boot 装配 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 响应式 WebClient：客户端用 SSE 流式调用服务端 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Jackson：中断 payload 里是内联 JSON 对象，要自己解析成 ToolCall，
             属直接使用，显式声明而不依赖传递依赖 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
