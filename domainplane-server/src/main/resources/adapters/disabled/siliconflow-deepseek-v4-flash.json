{
  "id": "siliconflow-deepseek-v4-flash",
  "provider": "siliconflow",
  "label": "DeepSeek-V4-Flash（硅基流动）",
  "docUrl": "https://docs.siliconflow.cn/cn/api-reference/chat-completions/create-chat-completion",
  "input": ["text"],
  "output": ["text"],
  "match": {
    "hosts": ["api.siliconflow.cn"],
    "models": ["deepseek-ai/DeepSeek-V4-Flash"]
  },
  "families": {
    "chat": {
      "params": [
        {
          "key": "temperature",
          "label": "温度",
          "type": "number",
          "wire": "temperature",
          "std": true,
          "min": 0,
          "max": 1,
          "step": 0.1,
          "default": 0.7
        },
        {
          "key": "maxTokens",
          "label": "单次最大输出",
          "type": "int",
          "wire": "max_tokens",
          "std": true,
          "min": 1,
          "max": 393216
        },
        {
          "key": "topP",
          "label": "核采样",
          "type": "number",
          "wire": "top_p",
          "std": false,
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.7
        },
        {
          "key": "topK",
          "label": "Top-K",
          "type": "int",
          "wire": "top_k",
          "std": false,
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 50
        },
        {
          "key": "stop",
          "label": "停止序列",
          "type": "stringList",
          "wire": "stop",
          "std": false,
          "max": 16
        },
        {
          "key": "responseFormat",
          "label": "返回格式",
          "type": "enum",
          "wire": "response_format",
          "std": false,
          "wireWrap": "type",
          "default": "text",
          "options": [
            {"value": "text"},
            {"value": "json_object"}
          ]
        },
        {
          "key": "frequencyPenalty",
          "label": "频率惩罚",
          "type": "number",
          "wire": "frequency_penalty",
          "std": false,
          "min": -2,
          "max": 2,
          "step": 0.01,
          "default": 0
        },
        {
          "key": "presencePenalty",
          "label": "存在惩罚",
          "type": "number",
          "wire": "presence_penalty",
          "std": false,
          "min": -2,
          "max": 2,
          "step": 0.01,
          "default": 0
        }
      ]
    }
  }
}
