<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zzkingcc</groupId>
        <artifactId>DomainPlane</artifactId>
        <version>v1.0-beta.2</version>
    </parent>

    <artifactId>domainplane-server</artifactId>
    <name>domainplane-server</name>
    <description>DomainPlane 服务端（可独立部署）：承载 Agent 编排 / 知识库 / 工具调用 / ES / Redis，暴露 HTTP + SSE 供 SDK 与工具实例连接</description>

    <dependencies>
        <!-- ===== 内部模块（服务端承载全部重逻辑） ===== -->
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-runtime</artifactId>
        </dependency>

        <!-- ===== Spring Boot 装配 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池（spring-boot-starter-data-redis 中为 optional，需显式引入） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ===== LangChain4j 集成 ===== -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- OpenAI 模型（核心库，无 spring-boot 自动装配；模型 Bean 由 AiModelConfiguration 构建） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- Anthropic 官方：/v1/messages，协议与鉴权头均与 OpenAI 不同，
             不能用 OpenAI 兼容适配器代劳。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-anthropic</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- Ollama：本地部署（/api/chat，无密钥概念），思考开关有原生 think 入口 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- langchain4j-dashscope 刻意不引：官方停更在 0.36.2（2024-11），
             与本项目的 1.18.x 不在同一依赖世代，引入会拖进一整套旧 core 并破坏依赖树。
             阿里云百炼走它自带的 OpenAI 兼容入口（compatible-mode/v1）即可，
             代价是拿不到原生模块才有的 audio 模态。等 1.x 出稳定版再补。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>
        <!-- langchain4j-easy-rag 刻意不引：它只是"一站式本地 RAG"的便利封装，本项目一个类都没用到，
             却会拖进近 180MB 传递依赖，
               · langchain4j-document-parser-apache-tika → Tika 全家桶（poi / xmlbeans / pdfbox / fontbox…，约 35MB）
               · langchain4j-embeddings-bge-small-en-v15-q → onnxruntime(93MB) + tokenizers(18.7MB) + djl + jna
             本项目的文档解析走自己的 DocumentProcessStrategy（上传内容按 UTF-8 直接取文本），
             向量化走 OpenAI 兼容的远端 EmbeddingModel，两者都不需要这些。
             若将来确实要接 Tika 解析或本地 embedding，再按需单独引入对应模块即可。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-elasticsearch</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- ===== LangGraph4j 集成（ChatMessage / ToolExecutionRequest 序列化器） ===== -->
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
            <version>${langgraph4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-langchain4j</artifactId>
            <version>${langgraph4j.version}</version>
        </dependency>

        <!-- ===== ES 客户端（强制锁定版本） ===== -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
            <version>${elasticsearch.version}</version>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
            <version>${elasticsearch.version}</version>
        </dependency>

        <!-- Lombok 只在编译期生成代码，provided 不进 fat jar（否则会给交付物白白加约 2MB） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ===== 密码哈希（BCrypt） =====
             只取 spring-security-crypto 这一个工具包，不引入 spring-boot-starter-security：
             本产品的鉴权是"单账号 + 签名凭证"，用不到 Security 的过滤器链 / 会话 / 角色体系，
             引入整套会把既有的轻量鉴权模型推翻，且会默认开启一堆与需求无关的拦截。
             版本显式锁定（不跟随 Boot 管理的版本），避免随 Boot 升级改变 BCrypt 行为。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>${spring-security-crypto.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- 交付包为平台无关的单文件 fat jar（字节码跨平台），不再带 -<系统>-<架构> 后缀：
             运行期存储目录（配置 / 日志）由 RuntimeEnvironment 在启动装配前按探测到的操作系统
             自动选择，可用 DOMAINPLANE_SETTINGS_PATH / DOMAINPLANE_LOG_PATH 环境变量或同名 JVM 系统属性覆盖。 -->
        <finalName>domainplane-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zzkingcc.domainplane.server.DomainPlaneServerApplication</mainClass>
                    <!-- Lombok 是编译期注解处理器，provided 作用域仍会被 Boot 打进 fat jar（约 2MB 纯浪费），
                         这里显式排除。它只在本模块编译时用得到，运行期与整个依赖树都无关。 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- 产出 META-INF/build-info.properties：版本号由构建信息提供，
                         探测接口不再硬编码版本字符串，避免"报的版本"与 jar 实际版本脱节 -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
