<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zzkingcc</groupId>
        <artifactId>DomainPlane</artifactId>
        <version>v1.0-beta.1</version>
    </parent>

    <artifactId>domainplane-infrastructure</artifactId>
    <name>domainplane-infrastructure</name>
    <description>DomainPlane 基础设施：会话记忆 / 检查点 / 文档导入（策略分片 + 向量化）</description>

    <dependencies>
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-common</artifactId>
        </dependency>

        <!-- LangChain4j  -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>
        <!-- LangChain4j  -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- LangGraph4j 核心（BaseCheckpointSaver） -->
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
        </dependency>

        <!-- ES 客户端（检索/写入均使用原生客户端） -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>

        <!-- Redis 会话记忆 / 检查点存储 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- docx 解析：段落样式（Heading N）只有 POI 直读拿得到；Excel（.xls/.xlsx）也走这一条 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- 旧版 .doc 解析：HWPF 只在 poi-scratchpad 里，poi-ooxml 不含 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
        </dependency>

        <!-- pdf 解析：字号 / 坐标 / 页码只有 PDFBox 拿得到（Tika 的输出里这些全丢） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Lombok 只在编译期生成代码，provided 不进交付物 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
