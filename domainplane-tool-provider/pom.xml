<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zzkingcc</groupId>
        <artifactId>DomainPlane</artifactId>
        <version>v1.0-beta.1</version>
    </parent>

    <artifactId>domainplane-tool-provider</artifactId>
    <name>domainplane-tool-provider</name>
    <description>DomainPlane 工具 SDK（工具提供方）：工具注册 + 注解扫描 + 心跳保活 + 工具调用回调端点。
        工具实现在这里、工具治理在服务端 —— 两者进程分离，工具实例不依赖 DomainPlane 任何内部模块。</description>

    <dependencies>
        <!-- ===== 公共契约层：工具注解契约 + 服务端连接配置 ===== -->
        <dependency>
            <groupId>com.zzkingcc</groupId>
            <artifactId>domainplane-sdk-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ===== Spring 集成（可选）：自动装配 + 工具调用端点 =====
             只用 spring-web 的注解模型（@RestController / @RequestBody），不引任何一个 Web 容器：
             客户应用自身是 MVC 还是 WebFlux 都能跑，容器由客户已有的依赖决定。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- 注解扫描要用 BeanFactory / ClassUtils / 参数名发现，直接使用故显式声明 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
    </dependencies>
</project>
