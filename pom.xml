<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.zzkingcc</groupId>
    <artifactId>DomainPlane</artifactId>
    <version>v1.0</version>
    <packaging>pom</packaging>
    <name>DomainPlane</name>
    <description>Java-based AI Workflow Orchestration Starter - 多模块聚合工程</description>

    <modules>
        <module>domainplane-api</module>
        <module>domainplane-common</module>
        <module>domainplane-domain</module>
        <module>domainplane-infrastructure</module>
        <module>domainplane-runtime</module>
        <module>domainplane-sdk-core</module>
        <module>domainplane-client-core</module>
        <module>domainplane-chat-client</module>
        <module>domainplane-kb-client</module>
        <module>domainplane-tool-provider</module>
        <module>domainplane-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <domainplane.version>v1.0</domainplane.version>
        <langchain4j.version>1.18.1</langchain4j.version>
        <langchain4j.beta.version>1.18.1-beta28</langchain4j.beta.version>
        <langgraph4j.version>1.8.17</langgraph4j.version>
        <elasticsearch.version>9.4.4</elasticsearch.version>
        <spring-security-crypto.version>6.3.3</spring-security-crypto.version>
        <poi.version>5.4.1</poi.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <awssdk.version>2.33.4</awssdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4j BOM -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- LangGraph4j BOM -->
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-bom</artifactId>
                <version>${langgraph4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              S3 兼容对象存储（COS / OSS / MinIO / AWS 共用一套驱动）。
              只引 s3 + url-connection-client：后者是同步实现，不带 netty，
              产物体积与启动期线程都比默认异步客户端小一个量级。
            -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <!--
              文档解析：docx 直读（title 层级只有 POI 能拿到）+ Excel（.xls 的 HSSF 在 poi、.xlsx 的 XSSF 在 poi-ooxml）。
              所以表格格式不需要额外构件，poi-ooxml 一条覆盖 docx / xls / xlsx。
            -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <!--
              文档解析：旧版 .doc（OLE2 二进制，HWPF）只存在于 poi-scratchpad，poi-ooxml 里没有。
              这是这一轮唯一新增的构件；它的传递依赖（poi / commons-io / commons-codec /
              commons-collections4 / log4j-api）已经都在依赖树里，没有额外体积。
            -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-scratchpad</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <!--
              文档解析：pdf 抽行。
              Java 生态里唯一能同时拿到「文本 + 字号 + 坐标 + 页码」的成熟纯 Java 库，Apache-2.0。
              Tika 走的是「格式无关纯文本」，恰好把字号与标题层级丢掉，所以 pdf 与 docx 都直连底层库。
            -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
                <exclusions>
                    <!-- PDFBox 自带 commons-logging；交给 spring-jcl 统一转 slf4j，避免两个 jcl 实现打架 -->
                    <exclusion>
                        <groupId>commons-logging</groupId>
                        <artifactId>commons-logging</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <!-- ===== 内部模块版本管理 ===== -->
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-api</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-common</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-domain</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-infrastructure</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-runtime</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-sdk-core</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-client-core</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-chat-client</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-kb-client</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zzkingcc</groupId>
                <artifactId>domainplane-tool-provider</artifactId>
                <version>${domainplane.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.10.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <!--
      安全扫描用的插件版本在这里钉死，但**默认不激活**。

      为什么走 profile 而不是直接进 <build>：本机与内网构建是 mvn -o 离线模式，
      这两个插件都不在本地仓库里 —— 一旦进默认 build，任何一次离线构建都会先失败在
      插件解析上，而且是"看起来像工程坏了"的那种失败。只有 CI 显式 -Psecurity 才解析。
    -->
    <profiles>
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.2.2</version>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <!-- CVSS >= 9 才判红：7 分以下的项目多为"理论可利用"，
                                 每次都判红等于把这门铃拆了 -->
                            <failBuildOnCVSS>9</failBuildOnCVSS>
                            <skipTestScope>true</skipTestScope>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.1</version>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
